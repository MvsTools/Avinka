{
  "env": {
    "NODE_OPTIONS": "--use-system-ca"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(npx tsc --noEmit *)",
      "Bash(npx --no-install tsc --noEmit *)",
      "Bash(NODE_OPTIONS=--use-system-ca npx tsc --noEmit *)",
      "Bash(npx eslint *)",
      "Bash(npx --no-install eslint *)",
      "Bash(NODE_OPTIONS=--use-system-ca npx eslint *)",
      "Bash(NODE_OPTIONS=--use-system-ca npx next build)",
      "Bash(NODE_OPTIONS=--use-system-ca npx next dev *)",
      "Bash(git merge-base *)",
      "Bash(git merge-tree *)",
      "Bash(git ls-tree *)",
      "Bash(git rev-list *)",
      "Bash(git check-ignore *)",
      "Bash(git grep *)",
      "Bash(git worktree list)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git rev-list *)",
      "PowerShell(git merge-base *)",
      "PowerShell(git merge-tree *)",
      "PowerShell(git ls-files *)",
      "PowerShell(npx tsc --noEmit *)",
      "PowerShell(npx tsc *)",
      "PowerShell(npx eslint *)",
      "PowerShell(npx next build *)",
      "PowerShell(npx next dev *)",
      "PowerShell(npx --no-install *)",
      "PowerShell(node *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run build *)",
      "Edit(src/**)",
      "Edit(public/**)",
      "Edit(docs/**)",
      "Edit(scripts/**)",
      "Edit(database/**)",
      "Write(src/**)",
      "Write(public/**)",
      "Write(docs/**)",
      "Write(scripts/**)",
      "Write(database/**)",
      "Write(//c/Users/micha/AppData/Local/Temp/claude/**)",
      "Edit(//c/Users/micha/AppData/Local/Temp/claude/**)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Item *)",
      "PowerShell(Resolve-Path *)",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_find",
      "mcp__playwright__browser_wait_for",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_migrations",
      "mcp__supabase__get_advisors",
      "mcp__supabase__get_project_url",
      "mcp__supabase__search_docs"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/herakkoord-reminder.mjs\"",
            "statusMessage": "Voorwaarden/privacy gewijzigd?"
          }
        ]
      }
    ]
  }
}
